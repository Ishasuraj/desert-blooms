# Gmail — used by the server to send enquiry emails
GMAIL_USER=desertbloooms@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Where enquiries are delivered (defaults to GMAIL_USER if unset)
ENQUIRY_TO_EMAIL=desertbloooms@gmail.com

# Business inbox for new order notifications
ORDER_NOTIFY_EMAIL=orders@example.com

# Public contact details shown on the website (optional)
VITE_CONTACT_PHONE=+965 50410443
VITE_CONTACT_PHONE_TEL=+96550410443
VITE_CONTACT_WHATSAPP=96560096148
VITE_CONTACT_EMAIL=desertbloooms@gmail.com

# Server
PORT=3000

# Supabase (server-side only; keep the service role key out of VITE_ variables)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Destination for order confirmation receipts
WHATSAPP_TARGET_NUMBER=your-order-confirmation-number
